# workspace.md baseline .gitignore.
#
# Adopters SHOULD extend this file for their own toolchain — doing so is
# CONFORMANT. The spec mandates folder topology (0-storage/ 1-active/
# 2-mind/ 3-control/), not a byte-identical .gitignore. Keep the
# Credentials block below intact; extend everything else freely.

# OS
.DS_Store
Thumbs.db
desktop.ini

# Editors / IDEs
.vscode/
.idea/
*.swp
*.swo
*~

# Credentials — never commit (keep these; secrets live OUTSIDE the workspace)
.env
.env.*
!.env.example
*-secrets/
*.key
*.pem
oauth_creds.json
auth.json

# Logs
*.log
logs/

# Build / dependency artifacts (extend per your stack)
node_modules/
dist/
build/
out/
target/
__pycache__/
*.pyc
.venv/
venv/
.mypy_cache/
.pytest_cache/
coverage/
*.coverage

# 0-storage/ — general file storage (LLM-passive: binaries, media, archives).
# Small reference assets MAY be committed. Large / binary / regenerable
# assets are commonly kept out of git; uncomment and tune to taste:
# 0-storage/**
# !0-storage/.gitkeep
